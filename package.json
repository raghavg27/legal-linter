{
  "name": "legal-lint-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter legal-lint build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:api": "pnpm --filter @legal-lint/api build"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.3",
    "@legal-lint/core": "workspace:*",
    "@legal-lint/rules": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^22.20.5",
    "legal-lint": "workspace:*",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
